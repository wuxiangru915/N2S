# N2S LLM Provider: mock (default), agnes, openai, anthropic, ollama, mimo
N2S_LLM_PROVIDER=mock

# Agnes (OpenAI-compatible)
# AGNES_API_KEY=your-agnes-key
# AGNES_BASE_URL=https://your-agnes-endpoint/v1
# AGNES_MODEL=agnes-2.0-flash

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (local)
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Mimo (OpenAI-compatible)
# MIMO_API_KEY=tp-...
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://your-mimo-endpoint/v1

# Demo database (optional; defaults to bundled demo DB)
# N2S_DEMO_DB=/path/to/n2s_demo.db
